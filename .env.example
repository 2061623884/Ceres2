# Blank credentials: configure your own OpenAI-compatible endpoint.
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=qwen3.8-27b
LLM_MODE=live
# Required for automatic new-text role/capability judgment, not app startup.
# Base URL must implement /v1/systemone with the current joint-choice contract.
# Empty/unavailable shows a routing error and explicit manual role continuation; no automatic fallback.
KEV_BASE_URL=
BUSINESS_DATA_MODE=demo
DATABASE_URL=sqlite:///data/runtime/ceres2.sqlite3
MERCURY_CHECKPOINT_PATH=data/runtime/mercury-checkpoints.sqlite3
# Pauses only cart/checkout mutations; query/case writes are not frozen.
SHOPPING_WRITES_PAUSED=false
# Separate human-operator credential; empty disables operator access.
HUMAN_OPERATOR_TOKEN=
# Independent background models; neither falls back to LLM_MODEL.
MEMORY_EXTRACTION_MODEL=qwen3.8-27b
MEMORY_DREAM_MODEL=qwen3.8-27b
